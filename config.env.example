# Machine-local settings for agent-config. Installed to ~/.config/agent-config/config.env
# on first install and never overwritten afterwards. Not tracked in git.

# Where this machine's clone of the agent-config repo lives (set by install.sh).
AGENT_CONFIG_DIR=

# Obsidian vault used by `vault-write` and the obsidian-vault skill.
# Either a fixed path…
VAULT_PATH=
# …or the label of the drive holding it, when its mount point changes between sessions
# (e.g. VAULT_DRIVE_LABEL=MyDrive and VAULT_SUBDIR=vaults/main).
VAULT_DRIVE_LABEL=
VAULT_SUBDIR=

# Note holding this machine's system changelog, relative to the vault root.
VAULT_CHANGELOG_NOTE=
