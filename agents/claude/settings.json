{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push * main*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push *:main*)",
      "Bash(git push * refs/heads/main*)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --all*)",
      "Bash(git push * --all*)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push -u origin)",
      "Bash(git push * HEAD)"
    ]
  },
  "env": {
    "PLAYWRIGHT_MCP_HEADLESS": "true",
    "PLAYWRIGHT_MCP_ISOLATED": "true",
    "GRAPHIFY_BACKEND": "none"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search 2>/dev/null || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard compact 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "model": "opus[1m]",
  "effortLevel": "xhigh",
  "theme": "dark",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 60
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "compound-engineering@compound-engineering-plugin": true,
    "github@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "task-progress@agent-config": true,
    "blast-radius@agent-config": true,
    "collision-guard@agent-config": true
  },
  "extraKnownMarketplaces": {
    "compound-engineering-plugin": {
      "source": {
        "source": "github",
        "repo": "EveryInc/compound-engineering-plugin"
      },
      "autoUpdate": true
    },
    "agent-config": {
      "source": {
        "source": "github",
        "repo": "panchomarq/agent-config"
      },
      "autoUpdate": true
    }
  }
}
